# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# The .env file is gitignored and will never be committed.

# ---------------------------------------------------------------------------
# Gemini (cloud) — required only when LLM_PROVIDER=gemini
# ---------------------------------------------------------------------------
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# ---------------------------------------------------------------------------
# LLM Provider — switch between "gemini" and "ollama"
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Gemini settings
# ---------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated browser origins. Use * for the bundled UI.
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Ollama settings — required only when LLM_PROVIDER=ollama
# ---------------------------------------------------------------------------
# 1. Install Ollama: https://ollama.com
# 2. Start it:      ollama serve
# 3. Pull model:    ollama pull llama3.2
OLLAMA_MODEL=llama3.2
